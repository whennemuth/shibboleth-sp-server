{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "rootDir": "./src",
    "types": [ "node" ],
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./dist/types",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": [ "src" ],
  "exclude": [ "src/test" ]
}