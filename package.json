{
  "name": "shibboleth-sp-server",
  "version": "1.0.0",
  "description": "Server components for shibboleth service provider with Express.js integration",
  "repository": {
    "type": "git",
    "url": "https://github.com/whennemuth/shibboleth-sp.git"
  },
  "scripts": {
    "build": "node src/build.js",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "pack": "npm pack --pack-destination .",
    "release": "npm publish",
    "watch": "tsc -w --noEmit",
    "test": "jest --silent",
    "docker-clean": "sh -c \"docker rmi $(docker images --filter dangling=true -q) 2> /dev/null || true\"",
    "deploy": "npm run build && docker compose down && npm run docker-clean && docker compose up --build -d --remove-orphans",
    "deploy-slim": "npm run build && npm run down-slim && npm run docker-clean && docker compose -f docker-compose-slim.yml up --build -d --remove-orphans --force-recreate",
    "up": "docker compose up -d",
    "down": "docker compose down || true",
    "up-slim": "docker compose -f docker-compose-slim.yml up -d --force-recreate",
    "down-slim": "docker compose -f docker-compose-slim.yml down || true"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@types/express": "^5.0.6",
    "axios": "^1.21.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "shibboleth-sp": "file:../shibboleth-sp/shibboleth-sp-1.0.2.tgz",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
