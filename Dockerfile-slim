# -----------------------------------------------------------
#                      STAGE 1
# -----------------------------------------------------------
FROM node:alpine AS ts-compilation

ENV NODE_ENV=development
USER root

# Install TypeScript globally for compilation
RUN npm install -g typescript

# Copy package files and install dependencies
COPY ./package.json ./sp/
WORKDIR /sp
RUN npm install

# Copy source files and TypeScript configuration
COPY ./src ./src/
COPY ./tsconfig.json ./

# Compile TypeScript to JavaScript
RUN npm run build:tsc

# -----------------------------------------------------------
#                      STAGE 2
# -----------------------------------------------------------
FROM node:alpine AS baseline

ENV NODE_ENV=production
USER root

# Copy compiled JavaScript from previous stage
COPY --from=ts-compilation /sp/dist ./sp/dist/
COPY --from=ts-compilation /sp/package.json ./sp/

# Install only production dependencies
WORKDIR /sp
RUN npm ci --only=production

# Specify the entrypoint
ENTRYPOINT [ "node" ]